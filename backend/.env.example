# Wartości domyślne są BEZPIECZNE DLA PRODUKCJI.
# Do pracy lokalnej ustaw: APP_ENV=local, APP_DEBUG=true, LOG_LEVEL=debug,
# SESSION_SECURE_COOKIE=false oraz APP_URL=http://127.0.0.1:8000
APP_NAME=MIRiOLA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Musi wskazywać rzeczywistą domenę — z tego budowane są adresy kanoniczne,
# JSON-LD i sitemap.xml.
APP_URL=https://ZMIEN-NA-DOMENE-PRODUKCYJNA.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TinyPNG API Key for automatic image compression
TINY_PNG_KEY=

# Bootstrap PIERWSZEGO konta administratora. Używane tylko wtedy, gdy w bazie
# nie ma jeszcze żadnego administratora — potem hasło zmienia się w panelu
# (/admin/profile), a seeder nigdy go nie nadpisze.
ADMIN_EMAIL=admin@miriola.pl
# Celowo puste: seeder rzuca wyjątkiem, dopóki tego nie ustawisz, więc skopiowany
# .env nie utworzy administratora ze znanym hasłem.
ADMIN_PASSWORD=

# Wymaga HTTPS. Ustaw false tylko lokalnie. See REVIEW.md M-3.
SESSION_SECURE_COOKIE=true
